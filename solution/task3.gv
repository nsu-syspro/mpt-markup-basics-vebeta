digraph DFA {
    rankdir=LR;
    node [shape=circle, fontname="Helvetica"];
    
    S [label="S"];
    q0 [label="0"];
    q1 [label="1"];
    q2 [label="2", shape=doublecircle];

    S -> q0;
    
    q0 -> q1 [label="a"];
    q0 -> q1 [label="b"];
    q1 -> q1 [label="c"];
    q1 -> q2 [label="d"];
}